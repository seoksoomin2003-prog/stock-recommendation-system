# Copy to `.env` (same folder) and fill in. `.env` is git-ignored; never commit it.
# Values already set in your shell take precedence over this file.

# REQUIRED for SEC EDGAR fundamentals (SEC fair-access policy: identify yourself).
# Format: "<AppName>/<version> <your real contact e-mail>". Placeholder domains
# (example.com, ...) are rejected. If unset, SEC is NOT queried and ROE/profit
# margin come from Yahoo only (disclosed in every report).
SEC_USER_AGENT=

# Investment capital in USD used for position sizing. There is NO default.
# Either set it here or pass --capital on every run.
QPP_CAPITAL=

# OPTIONAL. Legacy NewsAPI integration (not used by the recommendation pipeline).
NEWS_API_KEY=

# Optional operational overrides
# QPP_LOG_LEVEL=WARNING
# QPP_RUNS_DIR=runs
# QPP_CACHE_DIR=cache.nosync/provider

# ---- South Korea (P6-21..25) -------------------------------------------------
# KR capital in KRW (the USD QPP_CAPITAL above is never reused for Korea).
QPP_CAPITAL_KRW=
# OPTIONAL. Free OpenDART key (https://opendart.fss.or.kr/ -> 인증키 신청). Enables KR fundamentals.
OPENDART_API_KEY=
# OPTIONAL. Free KRX Open API key (https://openapi.krx.co.kr/), then apply for the daily trading
# services (유가증권/코스닥 일별매매정보). Enables official KRX prices and traded value (거래대금).
KRX_API_KEY=
